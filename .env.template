# StemStomp Configuration
# Copy this file to .env and fill in the values.

# Path to local stems directory
STEMSTOMP_STEMS_DIR=/opt/stemstomp/stems

# S3 bucket name for cloud sync (leave empty to disable)
STEMSTOMP_S3_BUCKET=

# Set to "1" to run without hardware (testing/development)
STEMSTOMP_DRY_RUN=0

# Logging level (DEBUG, INFO, WARNING, ERROR)
STEMSTOMP_LOG_LEVEL=INFO

# S3 key prefix for stems
STEMSTOMP_S3_PREFIX=stems/

# Cloud sync poll interval in seconds
STEMSTOMP_SYNC_INTERVAL=30

# GPIO pin assignments (BCM numbering)
STEMSTOMP_GPIO_RECORD=17
STEMSTOMP_GPIO_PLAYBACK=27
STEMSTOMP_GPIO_SYNC=22

# OLED display I2C settings
STEMSTOMP_OLED_PORT=1
STEMSTOMP_OLED_ADDRESS=0x3C

# OTA update settings
STEMSTOMP_GITHUB_REPO=parkredding/love-lane-pedal
STEMSTOMP_OTA_ASSET=stemstomp

# GitHub token (required only for private repos)
# GITHUB_TOKEN=

# AWS credentials (prefer IAM role or ~/.aws/credentials instead)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
