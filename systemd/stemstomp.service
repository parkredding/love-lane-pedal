[Unit]
Description=StemStomp Main Audio Application
After=network-online.target stemstomp-ota.service
Wants=network-online.target
Requires=stemstomp-ota.service

[Service]
Type=simple
User=stemstomp
WorkingDirectory=/opt/stemstomp
EnvironmentFile=/opt/stemstomp/.env
ExecStart=/opt/stemstomp/venv/bin/python main.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Security hardening
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/stemstomp/stems
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
